# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small static website generator"
description:
  "A tool for building static websites. It takes your content and templates and turns them into ready-to-publish HTML pages."
maintainer: ["Alkan-Meph"]
authors: ["Alkan-Meph"]
tags: ["blog" "static site generator" "markdown"]
homepage: "https://github.com/Alkan-Meph/balzac"
bug-reports: "https://github.com/Alkan-Meph/balzac/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml"
  "fpath"
  "re"
  "bos"
  "cmdliner" {>= "1.1.0"}
  "yaml"
  "ppx_deriving_yaml"
  "cmarkit"
  "jingoo"
  "uri"
  "tiny_httpd"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Alkan-Meph/balzac.git"
x-maintenance-intent: ["(latest)"]
